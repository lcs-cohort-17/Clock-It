{
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "google/apiclient": "^2.15.0",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^2.9",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Config\\": "src/config/",
            "Controllers\\": "src/controllers/",
            "Models\\": "src/models/",
            "Types\\": "src/types/",
            "Middleware\\": "src/middleware/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}