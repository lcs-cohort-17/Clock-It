{
    "name": "clock-it/phpbackend",
    "description": "PHP Backend for Clock-It",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.0",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
